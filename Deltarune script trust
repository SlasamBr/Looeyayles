EspTab:CreateButton({ Name = "Player Esp", Callback = function()
    pcall(function()
        local ESP_SETTINGS = {
            TextSize = 16,
            Font = Drawing.Fonts.Comic or Drawing.Fonts.UI,
            Colors = {
                [3] = Color3.fromRGB(0, 150, 255),
                [2] = Color3.fromRGB(0, 100, 200),
                [1] = Color3.fromRGB(0, 50, 150),
                [0] = Color3.fromRGB(0, 0, 0)
            },
            NametagColor = Color3.fromRGB(255, 255, 255),
            HealthColor = Color3.fromRGB(0, 255, 0)
        }

        local espCache = {}

        local function createESP(player)
            if player == LocalPlayer then return end

            local espData = {
                Nametag = Drawing.new("Text"),
                HealthText = Drawing.new("Text"),
                Highlight = nil,
                CachedHealth = 3
            }

            espData.Nametag.Visible = false
            espData.Nametag.Center = true
            espData.Nametag.Outline = true
            espData.Nametag.OutlineColor = Color3.fromRGB(0, 0, 0)
            espData.Nametag.Color = ESP_SETTINGS.NametagColor
            espData.Nametag.Size = ESP_SETTINGS.TextSize
            espData.Nametag.Font = ESP_SETTINGS.Font

            espData.HealthText.Visible = false
            espData.HealthText.Center = true
            espData.HealthText.Outline = true
            espData.HealthText.OutlineColor = Color3.fromRGB(0, 0, 0)
            espData.HealthText.Color = ESP_SETTINGS.HealthColor
            espData.HealthText.Size = ESP_SETTINGS.TextSize - 2
            espData.HealthText.Font = ESP_SETTINGS.Font

            espCache[player] = espData

            local function setupCharacter(character)
                if not character then return end
                character:WaitForChild("HumanoidRootPart", 5)

                if espData.Highlight then
                    pcall(function() espData.Highlight:Destroy() end)
                    espData.Highlight = nil
                end

                local success, highlight = pcall(function()
                    local h = Instance.new("Highlight")
                    h.Name = "CustomESP_Highlight"
                    h.Adornee = character
                    h.Parent = character
                    h.FillTransparency = 0.4
                    h.OutlineTransparency = 0
                    h.FillColor = ESP_SETTINGS.Colors[3]
                    h.OutlineColor = Color3.fromRGB(255, 255, 255)
                    return h
                end)

                if success and highlight then
                    espData.Highlight = highlight
                end
            end

            if player.Character then
                task.spawn(function() setupCharacter(player.Character) end)
            end

            player.CharacterAdded:Connect(setupCharacter)

            player.CharacterRemoving:Connect(function()
                espData.Nametag.Visible = false
                espData.HealthText.Visible = false
                if espData.Highlight then
                    pcall(function() espData.Highlight:Destroy() end)
                    espData.Highlight = nil
                end
            end)
        end

        local function removeESP(player)
            if espCache[player] then
                pcall(function()
                    espCache[player].Nametag:Remove()
                    espCache[player].HealthText:Remove()
                    if espCache[player].Highlight then
                        espCache[player].Highlight:Destroy()
                    end
                end)
                espCache[player] = nil
            end
        end

        for _, player in ipairs(Players:GetPlayers()) do
            createESP(player)
        end

        Players.PlayerAdded:Connect(createESP)
        Players.PlayerRemoving:Connect(removeESP)

        task.spawn(function()
            while true do
                for player, esp in pairs(espCache) do
                    local character = player.Character
                    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                    
                    if humanoid then
                        local health = math.clamp(math.floor(humanoid.Health), 0, 3)
                        esp.CachedHealth = health
                        local targetColor = ESP_SETTINGS.Colors[health] or ESP_SETTINGS.Colors[0]

                        if esp.Highlight and esp.Highlight.Parent then
                            esp.Highlight.FillColor = targetColor
                            if health == 0 then
                                esp.Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                            else
                                esp.Highlight.OutlineColor = Color3.fromRGB(0, 0, 0)
                            end
                        elseif character and not esp.Highlight then
                            local h = Instance.new("Highlight")
                            h.Name = "CustomESP_Highlight"
                            h.Adornee = character
                            h.Parent = character
                            h.FillTransparency = 0.4
                            h.OutlineTransparency = 0
                            h.FillColor = targetColor
                            esp.Highlight = h
                        end
                    end
                end
                task.wait(1)
            end
        end)

        RunService.RenderStepped:Connect(function()
            for player, esp in pairs(espCache) do
                local character = player.Character
                local rootPart = character and character:FindFirstChild("HumanoidRootPart")
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")

                if character and rootPart and humanoid and humanoid.Health > 0 then
                    local vector, onScreen = Camera:WorldToViewportPoint(rootPart.Position + Vector3.new(0, 3, 0))

                    if onScreen then
                        esp.Nametag.Text = player.Name
                        esp.Nametag.Position = Vector2.new(vector.X, vector.Y - 18)
                        esp.Nametag.Visible = true

                        esp.HealthText.Text = "Health: " .. esp.CachedHealth
                        esp.HealthText.Position = Vector2.new(vector.X, vector.Y)
                        esp.HealthText.Visible = true
                    else
                        esp.Nametag.Visible = false
                        esp.HealthText.Visible = false
                    end
                else
                    esp.Nametag.Visible = false
                    esp.HealthText.Visible = false
                end
            end
        end)
    end)
end})

