local playerEspEnabled = false
EspTab:CreateToggle({
    Name = "Player Esp",
    CurrentValue = false,
    Flag = "PlayerEspToggle",
    Callback = function(v)
        playerEspEnabled = v
        if playerEspEnabled then
            task.spawn(function()
                local ESP_SETTINGS = {
                    TextSize = 16,
                    Font = Drawing.Fonts.FredokaOne or Drawing.Fonts.Legacy or Drawing.Fonts.UI,
