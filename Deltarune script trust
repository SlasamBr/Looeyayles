                    if touchControlField then
                        local jumpButton = touchControlField:FindFirstChild("JumpButton")
                        if jumpButton then
                            jumpButton.Visible = true
                            jumpButton.Active = true
                        end
                    end
                end
            end)
        end)
    else
        if jumpConnection then
            jumpConnection:Disconnect()
            jumpConnection = nil
        end
        pcall(function()
            local touchGui = LocalPlayer.PlayerGui:FindFirstChild("TouchGui")
            if touchGui then
                local touchControlField = touchGui:FindFirstChild("TouchControlFrame")
                if touchControlField then
                    local jumpButton = touchControlField:FindFirstChild("JumpButton")
                    if jumpButton then
                        jumpButton.Visible = false
                        jumpButton.Active = false
                    end
                end
            end
        end)
    end
end })

